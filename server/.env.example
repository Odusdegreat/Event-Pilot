PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Walrus Memory delegate credentials
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Use production for a mainnet account, or the staging URL for staging credentials.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Auto-updated Nigerian event calendar feed.
# Any JSON feed shaped { "data": [{ "title"/"name", "start_date", "city", "event_status" }] } works.
NIGERIA_EVENTS_URL=https://techlinkup.xyz/api/events
EVENT_FEED_REFRESH_HOURS=6
